# Пример переменных окружения для проекта.
# По умолчанию рыночные данные берутся из MOEX ISS API.

# Какой источник использовать для цены акции.
# Доступные варианты:
# moex - реальные данные MOEX ISS API
# stub - локальная заглушка для отладки
MARKET_DATA_PROVIDER=moex

# Какой источник использовать для новостей.
# Доступные варианты:
# google_news_rss - бесплатная RSS-лента Google News
# stub - локальная заглушка для отладки
NEWS_PROVIDER=google_news_rss

# Какой источник использовать для анализа портфеля.
# Пока безопасное значение только одно: stub
PORTFOLIO_PROVIDER=stub

# Базовый URL официального MOEX ISS API.
MOEX_ISS_BASE_URL=https://iss.moex.com/iss

# Базовый URL RSS-поиска Google News.
GOOGLE_NEWS_RSS_URL=https://news.google.com/rss/search

# Таймаут запросов в секундах.
REQUEST_TIMEOUT_SECONDS=10

# Сколько новостей максимум показывать в ответе.
NEWS_MAX_ITEMS=5

# Токен Telegram-бота для локального запуска бота.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
